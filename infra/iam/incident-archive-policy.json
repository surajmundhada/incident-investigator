{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectOnlyTheArchiveBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPolicyStatus"
      ],
      "Resource": "arn:aws:s3:::${ARTIFACT_S3_BUCKET}",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    },
    {
      "Sid": "ReadAndWriteArchiveObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::${ARTIFACT_S3_BUCKET}/exports/v1/*",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    }
  ]
}
