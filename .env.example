# Recommended: python scripts/init_local_env.py generates an ignored .env with
# a random local PostgreSQL password. Existing .env files are never overwritten.
# This file documents placeholders; do not use CHANGE_ME as a real password.
POSTGRES_USER=investigator
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_LOCAL_ENV
POSTGRES_DB=investigator
# Compose uses 8001 so the optional SQLite preview can remain on 8000.
API_PORT=8001
# For host Python processes; Compose overrides the host to postgres.
# Compose constructs its internal DATABASE_URL from POSTGRES_*.
# Host Python processes must explicitly set this URL using their generated password.
DATABASE_URL=postgresql+psycopg://investigator:CHANGE_ME_GENERATE_WITH_INIT_LOCAL_ENV@localhost:5432/investigator
# Only this fixed source is queried. Incident inputs cannot supply arbitrary URLs.
EVIDENCE_BASE_URL=http://127.0.0.1:8091
# No LLM or AWS credentials are required for the first evidence-collection slice.
# Optional agent stage: keep disabled until a free-tier project and key are configured.
AGENT_MODE=disabled
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
# Optional cache for host processes; Compose -Cache sets its internal URL/enablement.
CACHE_ENABLED=0
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_NAMESPACE=local-dev
# Optional API-only normalized alert ingress. Keep empty to disable it.
ALERT_WEBHOOK_TOKEN=
# The -Artifacts override enables a local archive. S3 requires a separate explicit setup.
ARTIFACT_BACKEND=disabled
ARTIFACT_S3_BUCKET=
AWS_REGION=
ARTIFACT_S3_PRIVATE_CONFIRMED=0
